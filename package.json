{
  "name": "dsh-glassui",
  "version": "0.1.0",
  "description": "A Liquid Glass-style material for DSH (DeepSeek Harness) Web that works with every other plugin and survives DSH updates. Unofficial.",
  "type": "module",
  "license": "MIT",
  "author": "Aero123421",
  "homepage": "https://github.com/Aero123421/dsh-glassui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aero123421/dsh-glassui.git"
  },
  "bugs": {
    "url": "https://github.com/Aero123421/dsh-glassui/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "glass",
    "liquid-glass"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-reporter=spec --disable-warning=ExperimentalWarning \"test/unit/*.test.ts\"",
    "test:integration": "node scripts/build.mjs && node --test --test-reporter=spec --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:e2e": "node --test-reporter=spec test/e2e/run.mjs",
    "compat": "node scripts/compat.mjs",
    "pack": "node scripts/build.mjs && node scripts/pack.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "glassui": {
    "e2e": {
      "dsh": "0.2.1-alpha.2"
    }
  }
}
